generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  hashedPassword  String
  image           String?
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  memberships            Membership[]
  invitationsSent        InvitationToken[]
  tasksCreated           Task[]
  taskAssignedBy         TaskAssignment[]       @relation("AssignedByUser")
  certificationsVerified Certification[]        @relation("CertificationVerifier")
  eligibilityOverrides   EligibilityOverride[]  @relation("EligibilityOverrider")
  leaveReviewed          AvailabilityOverride[] @relation("LeaveReviewedBy")
  auditLogs              AuditLog[]
  notifications          Notification[]
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  industry            String?
  description         String?
  logo                String?
  address             String?
  templateId          String?
  status              String   @default("active")
  subscriptionTier    String   @default("free")   // "free" | "pro" | "enterprise"
  // Stripe billing (test mode). Set by the checkout webhook, not by users.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?  // "active" | "past_due" | "canceled" | ... (mirrors Stripe)
  billingInterval      String?  // "month" | "year"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships      Membership[]
  departments      Department[]
  invitationTokens InvitationToken[]
  roles            Role[]
  companySettings  CompanySettings?
  tasks            Task[]
  auditLogs        AuditLog[]
  workRules        WorkRule[]
  notifications    Notification[]
  certificationTypes CertificationType[]
}

model Membership {
  id                String   @id @default(cuid())
  userId            String
  organizationId    String
  role              String   @default("staff")
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  customRoleId      String?
  employmentType    String?  // "casual" | "full_time"
  // A manager pinning this member's seniority: "junior" | "experienced" |
  // "senior". NULL is the normal state and means "derive it from completed
  // shifts" — see src/lib/seniority.ts.
  //
  // The column exists because derivation has one failure mode it cannot fix on
  // its own: an experienced hire from another company has worked no shifts
  // here, so every count says junior on their first day, and a composition
  // rule would keep them off the shifts that would prove otherwise. NULL and
  // "junior" must therefore stay distinguishable — a default of "junior" would
  // silently convert every unreviewed member into a deliberate judgement.
  seniorityOverride String?

  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole            Role? @relation("MembershipCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)
  departmentMemberships DepartmentMembership[]
  taskAssignments       TaskAssignment[]
  availabilities        Availability[]
  availabilityOverrides AvailabilityOverride[]
  certifications        Certification[]
  eligibilityOverrides  EligibilityOverride[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Department {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workRules             WorkRule[]             @relation("WorkRuleDepartment")
  departmentMemberships DepartmentMembership[]
  tasks                 Task[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model DepartmentMembership {
  id           String   @id @default(cuid())
  membershipId String
  departmentId String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([membershipId, departmentId])
  @@index([departmentId])
}

model InvitationToken {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String
  departmentId   String?
  employmentType String?   // "casual" | "full_time" — carried to membership on accept
  token          String    @unique
  invitedById    String
  expires        DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([token])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  displayLabel   String
  description    String?
  isDefault      Boolean  @default(false)
  isSystemRole   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberCustomRoles Membership[]     @relation("MembershipCustomRole")
  rolePermissions RolePermission[]
  workRules       WorkRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String
  category    String

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model CompanySettings {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  allocationMode          String   @default("manual")
  taskAcceptanceMode      String   @default("auto_accept")
  /// The most hours a member may be rostered in one day.
  ///
  /// NOT a break rule, despite the column name. It is the daily cap the
  /// eligibility check enforces and the denominator for every capacity figure
  /// in reporting — `staffCount * this * 7` is a week's capacity. The break
  /// LENGTH that is actually enforced lives on a `break_interval` work rule,
  /// per rule and targetable, and the setting that used to sit beside this one
  /// pretending to be it was dead and was deleted on 2026-08-07.
  ///
  /// The misnomer sent an admin looking for a rest period this does not
  /// control. The UI label was corrected first ("Working day"); this renames
  /// the field the code reads.
  ///
  /// `@map` keeps the COLUMN called `breakRuleHoursWorked`, so this rename is
  /// a code change and not a migration — which matters here, because migration
  /// history is not baselined on any of the three databases and every schema
  /// change has to be applied by hand to each. The column name can be brought
  /// into line whenever something else needs a migration on this table.
  workingDayHours         Int      @default(8) @map("breakRuleHoursWorked")
  operatingHoursStart     Int      @default(6)
  operatingHoursEnd       Int      @default(22)
  smartAllocationWeights  String?
  notificationPreferences String?
  // Completed-shift counts at which a member is treated as experienced, then
  // senior. Configurable because the honest answer is industry-specific: ten
  // shifts is a competent barista and a novice nurse. Enforced senior >
  // experienced at validation, since an inverted pair makes "senior" either
  // unreachable or indistinguishable from "experienced".
  experiencedShiftThreshold Int    @default(10)
  seniorShiftThreshold      Int    @default(40)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Task {
  id                String    @id @default(cuid())
  organizationId    String
  departmentId      String?
  title             String
  description       String?
  requiredHeadcount Int       @default(1)
  // Names of certifications a staff member must hold (verified + non-expired)
  // to be eligible for this task. Empty = no certification requirement.
  requiredCertifications String[] @default([])
  // Constraints on the SET of people assigned rather than on each candidate:
  // "at most 1 assignee at Junior or below", "at least 1 holding First Aid".
  // JSON, following recurringPattern — see src/lib/composition-rules.ts for
  // the shape, the Zod schema and the feasibility rule.
  //
  // NULL and "[]" both mean no constraints and are not distinguished; nothing
  // reads the difference, unlike the provenance columns where absence is
  // itself a fact.
  compositionRules  String?
  status            String    @default("open")
  priority          String    @default("medium")
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  // A recurring task is the FIRST occurrence of a series and holds the pattern
  // (JSON — see lib/recurrence.ts). Later occurrences are ordinary tasks with
  // parentTaskId pointing back here, so they behave like any other task.
  isRecurring       Boolean   @default(false)
  recurringPattern  String?
  parentTaskId      String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /*
   * Restrict, not SetNull.
   *
   * A department-less task means ORG-WIDE work, so nulling the column on delete
   * made blank mean two different things — and a stranded task silently widens
   * eligibility to the whole organisation and switches seniority from
   * per-department to org-wide. Blank cannot mean both "I meant everyone" and
   * "my department was deleted".
   *
   * Same ambiguity 20260805000000_work_rule_targets_restrict removed for work
   * rules, and it wants the same treatment: an admin must reassign or delete a
   * department's shifts first, which is a step where they can see what they
   * would otherwise have stranded.
   */
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy    User             @relation(fields: [createdById], references: [id])
  assignments  TaskAssignment[]
  eligibilityOverrides EligibilityOverride[]
  parentTask         Task?  @relation("TaskRecurrence", fields: [parentTaskId], references: [id], onDelete: Cascade)
  recurringInstances Task[] @relation("TaskRecurrence")

  @@index([organizationId])
  @@index([departmentId])
  @@index([status])
  @@index([parentTaskId])
}

model TaskAssignment {
  id              String    @id @default(cuid())
  taskId          String
  membershipId    String
  // Lifecycle: pending → accepted → clocked_out → completed
  // Off-ramps: rejected (from pending), withdrawal_requested → withdrawn (from accepted)
  status          String    @default("pending")
  rejectionReason String?
  rejectionNotes  String?
  withdrawalReason String?  // one of DECLINE_REASONS (see src/lib/decline-reasons.ts); free text on rows predating structured reasons
  withdrawalNotes  String?  // optional free text alongside the reason — mirrors rejectionNotes
  clockInTime     DateTime?
  clockOutTime    DateTime?
  assignedById    String

  // --- Allocation provenance -------------------------------------------
  // How this assignment came to exist. All nullable: rows created before
  // this existed have no answer, and "unknown" must stay distinguishable
  // from "manual" or every historical row would be miscounted as a human
  // decision the engine never touched.
  //
  // allocationSource: "manual" | "ai_suggested" | "auto_scheduled"
  //   manual         — picked from the eligibility list by a person
  //   ai_suggested   — single-task auto-allocate took the engine's top N
  //   auto_scheduled — came from a confirmed week-long draft schedule
  // allocationProvider: "groq" | "gemini" | "algorithmic"
  //   Which strategy actually produced the ranking. Previously this only
  //   reached a console.error, so a silent permanent failover to the
  //   algorithmic ranker was invisible in production.
  // allocationScore / allocationRank: the engine's own numbers at the moment
  //   of assignment, kept so "did the manager take the top pick?" and
  //   "do high-scoring assignments get rejected less?" are answerable.
  allocationSource   String?
  allocationProvider String?
  allocationScore    Float?
  allocationRank     Int?

  // --- Response timing --------------------------------------------------
  // When the staff member answered. `updatedAt` cannot serve: every later
  // transition — clock in, clock out, completion — overwrites it, so by the
  // time a shift is worked the record of when it was accepted is gone. That
  // made every question of the form "are people responding faster or slower
  // than last month?" unanswerable.
  //
  // acceptedAt and rejectedAt are mutually exclusive. Both NULL on a row whose
  // status is "accepted" means nobody responded: either the organisation runs
  // auto-accept, or the row predates these columns. Reporting shows that as
  // its own bucket rather than folding it into the average, which would
  // otherwise fill with zero-second responses nobody actually made.
  acceptedAt            DateTime?
  rejectedAt            DateTime?

  // --- Clock correction --------------------------------------------------
  // A missed clock-out loses the hours, and until these existed nobody could
  // amend it — the member's history said the shift was not counted and offered
  // no way to fix it.
  //
  // The FACT of a correction lives here so the member can see it on their own
  // history without an audit-log page they may not have a plan for. The BEFORE
  // and AFTER values live in the audit row, which is where a value nobody
  // should be able to quietly restate belongs.
  //
  // `clockCorrectedAt` rather than reading `updatedAt`: every later transition
  // overwrites that column, which is exactly why acceptedAt and rejectedAt
  // exist above.
  clockCorrectedAt      DateTime?
  clockCorrectedById    String?
  clockCorrectionReason String?
  // Notice given before dropping out of an accepted shift. Separate from the
  // two above because it answers a different question — not "how quickly do
  // they reply" but "how much warning do we get", which is the counterpart to
  // the insufficient_notice decline reason staff already select.
  withdrawalRequestedAt DateTime?

  // --- Satisfaction -----------------------------------------------------
  // The staff member's own rating of a worked shift, 1–5, with optional free
  // text. Joins against the allocation columns above to answer the question
  // the provenance work was really for: were the engine's high-scoring picks
  // rated any better than the rest?
  satisfactionRating  Int?
  satisfactionComment String?
  ratedAt             DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignedBy User       @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@unique([taskId, membershipId])
  @@index([taskId])
  @@index([membershipId])
  @@index([status])
  // The AI panel groups by source within an org and a date window. Without
  // this it is a full scan of every assignment on the platform.
  @@index([allocationSource, createdAt])
}

model Availability {
  id           String   @id @default(cuid())
  membershipId String
  dayOfWeek    Int
  startTime    String
  endTime      String
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, dayOfWeek])
  @@index([membershipId])
}

model AvailabilityOverride {
  id           String   @id @default(cuid())
  membershipId String
  date         DateTime
  isAvailable  Boolean  @default(false)
  reason       String?
  /*
   * "approved" | "pending" | "rejected".
   *
   * The row means different things depending on who wrote it, and this is the
   * field that carries the difference.
   *
   * A CASUAL member's availability is an offer — theirs to give and to take
   * back — so their overrides are created "approved" and take effect at once,
   * exactly as every override did before this column existed. A FULL-TIME
   * member is contracted, so an absence is a leave request: created "pending"
   * and ignored by the roster until a manager approves it.
   *
   * Defaulting to "approved" is what makes the change safe on existing data.
   * Every row written before this column belonged to the old, immediate
   * behaviour, and backfilling them to "pending" would retroactively put
   * people back on shifts they had already been excused from.
   */
  status       String   @default("approved")
  reviewedById String?
  /*
   * When the review clock last started.
   *
   * NOT `createdAt`, and not `updatedAt`, because neither can answer this.
   * `createOverride` UPSERTS: editing a declined request resets it to pending
   * and clears the review, which is a new request on an old row and deserves a
   * new clock — `createdAt` will not move, so an edited request would arrive
   * permanently overdue. And `updatedAt` is `@updatedAt`, so the moment the
   * reminder job writes `remindedAt` below, the clock it just measured resets
   * and the request can never be overdue again.
   *
   * Nullable only so existing rows can carry the column; every write sets it.
   */
  submittedAt  DateTime?
  /*
   * When the reviewers were chased, and when it went above them.
   *
   * Held here rather than derived from the notification log, which cannot
   * answer it: `notifyIfEnabled` writes NOTHING when an organisation has that
   * notification type switched off, so "no notification row" means either "not
   * yet chased" or "reminders are disabled here". An organisation that opted
   * out would be swept on every run forever, and the day they opted back in,
   * every pending request would fire at once.
   *
   * Both are cleared by the upsert alongside `reviewedById`, for the same
   * reason it clears that: a re-submitted request carrying last round's
   * `remindedAt` would never be chased again — a request made invisible to the
   * system by being edited.
   */
  remindedAt   DateTime?
  escalatedAt  DateTime?
  /*
   * When the MEMBER was told nobody answered in time.
   *
   * A fourth mark rather than a reuse of the two above, which cannot serve: a
   * request that lapses has usually been chased already, so `remindedAt` is
   * set — and a field that means "chased" for one row and "member told" for
   * another can only be read by knowing which. Different recipient, different
   * message, different question.
   */
  lapseNotifiedAt DateTime?
  /*
   * There is deliberately no `reviewedAt`. `updatedAt` already records when the
   * row last changed, and a reviewed leave request does not change again — so a
   * separate timestamp would be a second copy of the same fact, free to drift
   * from the first. Who reviewed it is NOT derivable that way, which is why
   * `reviewedById` earns its column and the timestamp does not.
   */
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  /*
   * SetNull, not Cascade. Who approved a leave request is a fact about the
   * request, and deleting the reviewer's user account must not delete the
   * leave with it — the absence still happened.
   */
  reviewedBy   User?    @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([membershipId, date])
  @@index([membershipId])
  @@index([status])
}

model Certification {
  id           String    @id @default(cuid())
  membershipId String
  name         String
  issuedDate   DateTime
  expiryDate   DateTime?
  documentUrl  String?
  // "pending" | "verified" | "rejected" | "revoked".
  // rejected = never accepted. revoked = was verified, later withdrawn.
  status       String    @default("pending")
  // Set when a manager rejects OR revokes. Reused for both: the audit log holds
  // the full history, so the row only needs the current reason.
  rejectionReason String?
  rejectionNotes  String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation("CertificationVerifier", fields: [verifiedById], references: [id])

  @@index([membershipId])
  @@index([status])
}

/// The certificates an organisation recognises — its vocabulary, not its rules.
///
/// `Certification.name` is typed by the STAFF MEMBER and
/// `Task.requiredCertifications` is typed by the MANAGER, and eligibility
/// compares the two by lower-cased string equality. Nothing ever brought those
/// two vocabularies together, so the app's own placeholders disagreed — "e.g.
/// Food Safety Level 2" on one screen, "e.g. Food Safety, RSA" on the other.
/// Follow both hints and the holder is silently ineligible for a shift they are
/// qualified for, and told they are "Missing required certification(s): Food
/// Safety" while holding one.
///
/// This table is the shared list both sides draw from. It is deliberately NOT
/// referenced by id from either place: the task column stays a `String[]` and
/// the member row keeps its own `name`, so adopting it needed no data
/// migration and no change to the matching rule. The cost is that renaming an
/// entry does not follow into rows already written — recorded rather than
/// solved.
///
/// The two sides use it differently, and that asymmetry is the design:
///   - a TASK may only require a name on this list, because a requirement
///     spelled wrong is a shift nobody can fill
///   - a MEMBER may still submit anything, because a certificate nobody
///     requires is simply a true fact about a person
model CertificationType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Postgres compares these case-SENSITIVELY, so this stops "Food Safety"
  /// twice and not "Food Safety" beside "food safety". Eligibility lower-cases
  /// before comparing, so those two would be one certificate wearing two
  /// entries. `CertificationTypeService` enforces the case-insensitive rule;
  /// this is the backstop, following `Role`'s split between a database
  /// constraint on the slug and a service check on the label.
  @@unique([organizationId, name])
  @@index([organizationId])
}

model EligibilityOverride {
  id             String   @id @default(cuid())
  taskId         String
  membershipId   String
  overriddenById String
  reason         String
  ruleOverridden String
  createdAt      DateTime @default(now())

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  overriddenBy User     @relation("EligibilityOverrider", fields: [overriddenById], references: [id])

  @@index([taskId])
  @@index([membershipId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  type           String
  title          String
  message        String
  entityType     String?
  entityId       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, isRead])
  @@index([userId, organizationId, createdAt])
  @@index([organizationId])
}

model WorkRule {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  type            String   // "break_interval" | "max_hours_daily" | "max_hours_weekly"
  roleId          String?  // null = applies to all staff
  departmentId    String?  // null = applies to all departments
  hoursThreshold  Float?   // for break_interval: every X hours
  breakHours      Float?   // for break_interval: require Y hours break
  maxHours        Float?   // for max_hours_daily/weekly: cap at X hours
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /*
   * Restrict, not SetNull.
   *
   * A rule with NEITHER target set means "everybody" — that is how a global
   * rule is expressed. Under SetNull, deleting the role or department a rule
   * pointed at blanked the reference, and the rule silently became org-wide:
   * "trainees need 11 hours off" quietly turned into "everyone does", with
   * nothing to distinguish it from a rule someone deliberately made global.
   *
   * The ambiguity is the fault — blank cannot mean both "I meant everyone" and
   * "my target was deleted". Restrict removes it at the source by refusing the
   * delete while rules still point at the row. `RoleService.delete` and
   * `DepartmentService.delete` check first and refuse with a message naming the
   * rules, so the constraint is the backstop rather than the error the user
   * sees.
   *
   * It fails in the safe direction either way — a widened rule refuses MORE
   * rostering, never less — but silently wrong is still wrong, and it surfaces
   * as managers unable to roster people for reasons that make no sense.
   */
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department   Department?  @relation("WorkRuleDepartment", fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model IndustryTemplate {
  id             String   @id @default(cuid())
  name           String   @unique
  icon           String   @default("Building")
  description    String
  departments    Json     // Array of {name, description, color}
  workRules      Json     // Array of {name, type, hoursThreshold?, breakHours?, maxHours?, reason}
  certifications Json     // Array of strings
  isActive       Boolean  @default(true)
  isAiGenerated  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}