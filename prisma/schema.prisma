generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  hashedPassword  String
  image           String?
  isPlatformAdmin Boolean   @default(false)
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  memberships            Membership[]
  invitationsSent        InvitationToken[]
  tasksCreated           Task[]
  taskAssignedBy         TaskAssignment[]       @relation("AssignedByUser")
  certificationsVerified Certification[]        @relation("CertificationVerifier")
  eligibilityOverrides   EligibilityOverride[]  @relation("EligibilityOverrider")
  auditLogs              AuditLog[]
  notifications          Notification[]
  projectsCreated        Project[] @relation("ProjectCreator")
  assistantOperations    AssistantOperation[]
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  industry            String?
  description         String?
  logo                String?
  address             String?
  templateId          String?
  status              String   @default("active")
  subscriptionTier    String   @default("free")   // "free" | "pro" | "enterprise"
  // Stripe billing (test mode). Set by the checkout webhook, not by users.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?  // "active" | "past_due" | "canceled" | ... (mirrors Stripe)
  billingInterval      String?  // "month" | "year"
  stripeLastEventAt    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships      Membership[]
  departments      Department[]
  invitationTokens InvitationToken[]
  roles            Role[]
  companySettings  CompanySettings?
  tasks            Task[]
  projects         Project[]
  auditLogs        AuditLog[]
  stripeWebhookEvents StripeWebhookEvent[]
  workRules        WorkRule[]
  notifications    Notification[]
  certificationDefinitions CertificationDefinition[]
  assistantOperations AssistantOperation[]
  contactSubmissions ContactSubmission[]
}

model StripeWebhookEvent {
  id             String   @id // Stripe event id
  organizationId String
  type           String
  eventCreatedAt DateTime
  outcome        String
  processedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventCreatedAt])
}

model Membership {
  id                String   @id @default(cuid())
  userId            String
  organizationId    String
  role              String   @default("staff")
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  customRoleId      String?
  employmentType    String?  // "casual" | "temporary_part_time"

  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole            Role? @relation("MembershipCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)
  departmentMemberships DepartmentMembership[]
  taskAssignments       TaskAssignment[]
  projectMemberships    ProjectMember[]
  availabilities        Availability[]
  availabilityOverrides AvailabilityOverride[]
  certifications        Certification[]
  eligibilityOverrides  EligibilityOverride[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Department {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workRules             WorkRule[]             @relation("WorkRuleDepartment")
  departmentMemberships DepartmentMembership[]
  tasks                 Task[]
  projects              Project[]
  certificationRequirements CertificationDefinitionDepartment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model DepartmentMembership {
  id           String   @id @default(cuid())
  membershipId String
  departmentId String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([membershipId, departmentId])
  @@index([departmentId])
}

model InvitationToken {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String
  departmentId   String?
  employmentType String?   // "casual" | "temporary_part_time" — carried to membership on accept
  token          String    @unique
  invitedById    String
  expires        DateTime
  acceptedAt     DateTime?
  emailDeliveryStatus String @default("pending")
  emailDeliveryError  String?
  emailSentAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([token])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  displayLabel   String
  description    String?
  isDefault      Boolean  @default(false)
  isSystemRole   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberCustomRoles Membership[]     @relation("MembershipCustomRole")
  rolePermissions RolePermission[]
  workRules       WorkRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String
  category    String

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model CompanySettings {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  allocationMode          String   @default("auto")
  breakRuleHoursWorked    Int      @default(8)
  breakRuleBreakHours     Int      @default(1)
  operatingHoursStart     Int      @default(6)
  operatingHoursEnd       Int      @default(22)
  smartAllocationWeights  String?
  notificationPreferences String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Task {
  id                String    @id @default(cuid())
  organizationId    String
  departmentId      String?
  projectId         String?
  title             String
  description       String?
  location          String?
  instructions      String?
  requiredHeadcount Int       @default(1)
  // Names of certifications a staff member must hold (verified + non-expired)
  // to be eligible for this task. Empty = no certification requirement.
  requiredCertifications String[] @default([])
  status            String    @default("open")
  priority          String    @default("medium")
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  // A recurring task is the FIRST occurrence of a series and holds the pattern
  // (JSON — see lib/recurrence.ts). Later occurrences are ordinary tasks with
  // parentTaskId pointing back here, so they behave like any other task.
  isRecurring       Boolean   @default(false)
  recurringPattern  String?
  parentTaskId      String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User             @relation(fields: [createdById], references: [id])
  assignments  TaskAssignment[]
  eligibilityOverrides EligibilityOverride[]
  parentTask         Task?  @relation("TaskRecurrence", fields: [parentTaskId], references: [id], onDelete: Cascade)
  recurringInstances Task[] @relation("TaskRecurrence")

  @@index([organizationId])
  @@index([departmentId])
  @@index([status])
  @@index([parentTaskId])
  @@index([projectId])
}

model TaskAssignment {
  id              String    @id @default(cuid())
  taskId          String
  membershipId    String
  // Lifecycle: assigned -> in_progress -> clocked_out -> completed
  // Off-ramps: withdrawal_requested -> withdrawn, or cancelled
  status          String    @default("assigned")
  withdrawalReason String?  // reason a staff member gave when requesting to withdraw
  withdrawalRequestedAt DateTime?
  withdrawalReviewedAt  DateTime?
  withdrawalReviewedById String?
  withdrawalDecision     String?
  withdrawalStatusBeforeRequest String?
  clockInTime     DateTime?
  clockOutTime    DateTime?
  cancelledAt     DateTime?
  cancelledById   String?
  cancellationReason String?
  assignedById    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignedBy User       @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@unique([taskId, membershipId])
  @@index([taskId])
  @@index([membershipId])
  @@index([status])
}

model Availability {
  id           String   @id @default(cuid())
  membershipId String
  dayOfWeek    Int
  startTime    String
  endTime      String
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, dayOfWeek])
}

model AvailabilityOverride {
  id           String   @id @default(cuid())
  membershipId String
  date         DateTime
  isAvailable  Boolean  @default(false)
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, date])
  @@index([membershipId])
}

model Certification {
  id           String    @id @default(cuid())
  membershipId String
  name         String
  issuedDate   DateTime
  expiryDate   DateTime?
  documentUrl  String?
  // "pending" | "verified" | "rejected" | "revoked".
  // rejected = never accepted. revoked = was verified, later withdrawn.
  status       String    @default("pending")
  // Set when a manager rejects OR revokes. Reused for both: the audit log holds
  // the full history, so the row only needs the current reason.
  rejectionReason String?
  rejectionNotes  String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation("CertificationVerifier", fields: [verifiedById], references: [id])

  @@index([membershipId])
  @@index([status])
}

model EligibilityOverride {
  id             String   @id @default(cuid())
  taskId         String
  membershipId   String
  overriddenById String
  reason         String
  ruleOverridden String
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  overriddenBy User     @relation("EligibilityOverrider", fields: [overriddenById], references: [id])

  @@index([taskId])
  @@index([membershipId])
  @@index([taskId, membershipId, revokedAt])
}

/**
 * Durable record of an operations-assistant mutation. Undo requests reference
 * this server-created record instead of trusting task or assignment IDs sent
 * by the browser.
 */
model AssistantOperation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  status         String   @default("completed")
  undoPayload    Json?
  expiresAt      DateTime?
  undoneAt       DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
}

/** Public sales/contact requests submitted from the landing page. */
model ContactSubmission {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  email          String
  company        String?
  message        String
  status         String   @default("new")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
}

/** Shared production rate-limit counters. */
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  type           String
  title          String
  message        String
  entityType     String?
  entityId       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, isRead])
  @@index([userId, organizationId, createdAt])
  @@index([organizationId])
}

model WorkRule {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  type            String   // "break_interval" | "max_hours_daily" | "max_hours_weekly"
  roleId          String?  // null = applies to all staff
  departmentId    String?  // null = applies to all departments
  hoursThreshold  Float?   // for break_interval: every X hours
  breakHours      Float?   // for break_interval: require Y hours break
  maxHours        Float?   // for max_hours_daily/weekly: cap at X hours
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  department   Department?  @relation("WorkRuleDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model IndustryTemplate {
  id             String   @id @default(cuid())
  name           String   @unique
  icon           String   @default("Building")
  description    String
  departments    Json     // Array of {name, description, color}
  workRules      Json     // Array of {name, type, hoursThreshold?, breakHours?, maxHours?, reason}
  certifications Json     // Array of strings
  isActive       Boolean  @default(true)
  isAiGenerated  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CertificationDefinition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentRequirements CertificationDefinitionDepartment[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model CertificationDefinitionDepartment {
  certificationDefinitionId String
  departmentId               String
  isRequired                 Boolean @default(false)

  certificationDefinition CertificationDefinition @relation(fields: [certificationDefinitionId], references: [id], onDelete: Cascade)
  department              Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([certificationDefinitionId, departmentId])
  @@index([departmentId])
}

/** A multi-task delivery outcome. Recurring task links remain separate. */
model Project {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  title          String
  description    String?
  status         String   @default("planning")
  priority       String   @default("medium")

  // task_based:
  // Every work item is allocated independently from all eligible staff.
  //
  // project_team:
  // A persistent Project Team is maintained and smart allocation for
  // project work items only considers eligible members of that team.
  staffingMode   String   @default("task_based")

  plannedStart   DateTime?
  plannedEnd     DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("ProjectCreator", fields: [createdById], references: [id])

  tasks          Task[]
  projectMembers ProjectMember[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([staffingMode])
  @@index([plannedStart, plannedEnd])
}

/**
 * Long-running membership of a Project Team.
 *
 * This does NOT reserve the staff member's calendar for the whole project.
 * Scheduling conflicts continue to come from actual TaskAssignments.
 */
model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  membershipId String
  createdAt    DateTime @default(now())

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([projectId, membershipId])
  @@index([projectId])
  @@index([membershipId])
}
